# /etc/craftkeeper/config.env — see docs/CONFIGURATION.md
# Comma-separated host:port list. Never bind to a public interface.
# HTTPS via `tailscale serve` (docs/INSTALL.md): loopback only, and the cookie always Secure.
LISTEN=127.0.0.1:8090
SECURE_COOKIE=true
# Without HTTPS instead: LISTEN=127.0.0.1:8090,100.126.54.17:8090 and SECURE_COOKIE=false
DATA_DIR=/var/lib/craftkeeper
DOCKER_SOCKET=/var/run/docker.sock
LOG_LEVEL=info
# Host TCP ports for game servers (inclusive). Crafty uses 25500-25600 on mesquita-server.
GAME_PORTS=25601-25700
