# /etc/mesquita-panel/config.env — see docs/CONFIGURATION.md
# Comma-separated host:port list. Never bind to a public interface; use localhost and Tailscale.
MESQUITA_LISTEN=127.0.0.1:8090,100.126.54.17:8090
MESQUITA_DATA_DIR=/var/lib/mesquita-panel
MESQUITA_DOCKER_SOCKET=/var/run/docker.sock
MESQUITA_LOG_LEVEL=info
